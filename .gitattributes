# 默认：仓库内统一 LF，避免跨平台换行符污染
* text=auto eol=lf

# 必须保持 LF 的文件（在 NAS / Linux 上执行）
cmd/*            eol=lf
manifest         eol=lf
ui/config        eol=lf
config/privilege eol=lf
config/resource  eol=lf
*.sh             eol=lf

# Windows 专用脚本保留 CRLF
*.ps1            text eol=crlf

# 二进制文件不做任何转换
*.png            binary
*.fpk            binary
