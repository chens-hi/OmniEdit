#!/bin/bash
# OmniEdit 运行控制 / lifecycle: start | stop | status
# fnOS 会在应用启动、停止、状态查询时调用本脚本。
# 退出码: 0 成功/运行中, 1 失败, 3(status) 未运行

set -u

# 应用运行文件目录（target -> /vol{n}/@appcenter/{appname}）
APP_BIN="${TRIM_APPDEST}/omniedit"
APP_STATIC="${TRIM_APPDEST}/dist"
APP_SOCK="${TRIM_APPDEST}/app.sock"
# 持久化运行数据目录（var -> @appdata）
PID_FILE="${TRIM_PKGVAR}/omniedit.pid"
LOG_FILE="${TRIM_PKGVAR}/omniedit.log"

# 用户可见错误写入 TRIM_TEMP_LOGFILE
report_error() {
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    echo "$1" > "$TRIM_TEMP_LOGFILE"
  fi
}

is_running() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  return 1
}

cleanup_stale_pid() {
  rm -f "$PID_FILE" 2>/dev/null || true
}

start() {
  if is_running; then
    # 已在运行，视为成功（幂等）
    exit 0
  fi
  cleanup_stale_pid

  if [ ! -x "$APP_BIN" ]; then
    report_error "OmniEdit 后端二进制缺失: ${APP_BIN}"
    exit 1
  fi
  if [ ! -d "$APP_STATIC" ]; then
    report_error "前端资源目录缺失: ${APP_STATIC}"
    exit 1
  fi

  mkdir -p "$TRIM_PKGVAR" 2>/dev/null || true
  # 清理可能残留的 socket 文件
  rm -f "$APP_SOCK" 2>/dev/null || true

  # 后台启动服务；TRIM_API_TOKEN 由系统注入到本进程环境，子进程自动继承
  nohup "$APP_BIN" \
    --socket "$APP_SOCK" \
    --static "$APP_STATIC" \
    >> "$LOG_FILE" 2>&1 &

  local pid=$!
  echo "$pid" > "$PID_FILE"

  # 简单等待并确认进程存活
  sleep 1
  if kill -0 "$pid" 2>/dev/null; then
    exit 0
  fi
  report_error "OmniEdit 后端启动失败，详见日志: ${LOG_FILE}"
  cleanup_stale_pid
  exit 1
}

stop() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      # 等待进程退出，最多 ~5s
      for _ in 1 2 3 4 5; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
      done
      # 仍存活则强制结束
      if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
      fi
    fi
  fi
  cleanup_stale_pid
  rm -f "$APP_SOCK" 2>/dev/null || true
  exit 0
}

status() {
  if is_running; then
    exit 0   # 运行中
  fi
  exit 3     # 未运行
}

case "${1:-}" in
  start)  start ;;
  stop)   stop ;;
  status) status ;;
  *)
    echo "Usage: $0 {start|stop|status}" >&2
    exit 1
    ;;
esac
